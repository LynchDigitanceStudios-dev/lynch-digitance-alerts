{
  "manifest_version": 3,
  "name": "Lynch Digitance Alerts",
  "version": "1.15.1",
  "description": "Watches your logged-in Fiverr tabs and relays new buyer messages, orders and notifications to Telegram in seconds. Optional: reply to buyers from Telegram.",
  "permissions": [
    "storage",
    "notifications",
    "tabs",
    "alarms",
    "scripting",
    "downloads",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.fiverr.com/*",
    "https://api.callmebot.com/*",
    "https://api.telegram.org/*",
    "https://alerts.lynchdigitancestudios.workers.dev/*",
    "https://alerts-ai.lynchdigitancestudios.workers.dev/*",
    "https://lynch-digitance-alerts.pages.dev/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.fiverr.com/*"
      ],
      "js": [
        "fiverr-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.fiverr.com/*"
      ],
      "js": [
        "fiverr-content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Lynch Digitance Alerts",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
